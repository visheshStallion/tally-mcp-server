{
  "name": "tally-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing Tally (TallyPrime / Tally.ERP 9) accounting data and operations to LLM tools via the Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tally-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc -p tsconfig.json --watch",
    "web": "tsx src/web/server.ts",
    "web:start": "node dist/web/server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tally",
    "tallyprime",
    "accounting",
    "erp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
